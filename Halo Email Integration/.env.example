# Required for local development and production. This encrypts Halo grants and
# seven-day ordinary-attachment staging records, so keep it stable across instances.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HALO_TOKEN_ENCRYPTION_KEY=

# PostgreSQL is required. The defaults match the local Docker Compose service.
# Keep credentials out of DATABASE_URL so secret stores can supply them separately.
DATABASE_URL=postgresql://localhost:5432/haloaddin
DATABASE_USERNAME=haloaddin
DATABASE_PASSWORD=haloaddin_local
# Optional authentication mode. Unset, password, psk, and usernamepassword use
# DATABASE_USERNAME and DATABASE_PASSWORD. Use entra to replace the password with
# an Azure managed identity token while retaining DATABASE_USERNAME.
# DATABASE_AUTH=entra
# Test settings default to the local Compose values above.
# TEST_DATABASE_URL=postgresql://localhost:5432/haloaddin
# TEST_DATABASE_USERNAME=haloaddin
# TEST_DATABASE_PASSWORD=haloaddin_local
# Optional pool and TLS overrides. TLS defaults off for localhost and on elsewhere.
# DATABASE_POOL_MAX=5
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_SSL=1
# DATABASE_SSL_REJECT_UNAUTHORIZED=1

# HaloPSA tenant origin and OAuth API application client ID.
HALO_URL=https://your-company.halopsa.com
HALO_CLIENT_ID=

# Microsoft Entra application (client) ID for the Office add-in app registration.
ADDIN_CLIENT_ID=

# Required by production builds; omit for the localhost development server.
# Use the deployed HTTPS origin only, with no trailing path.
# PUBLIC_BASE_URL=https://your-addin-host.example.com

# Optional bug reporting through a GitHub Issues repository.
# Use a fine-grained token scoped to this repository with Issues: Read and write.
BUG_REPORT_GITHUB_REPOSITORY=owner/repository
BUG_REPORT_GITHUB_TOKEN=
# BUG_REPORT_SESSION_TTL_MINUTES=15

# Optional overrides. Defaults are derived from ADDIN_CLIENT_ID.
# ADDIN_API_CLIENT_ID=<ADDIN_CLIENT_ID>
# ADDIN_API_AUDIENCE=api://<ADDIN_CLIENT_ID>
# ADDIN_AUTH_SCOPES=api://<ADDIN_CLIENT_ID>/access_as_user
# ADDIN_REQUIRED_SCOPE=access_as_user
# Set to 0 to disable safe inline-image stage diagnostics.
# INLINE_IMAGE_DIAGNOSTICS=0
# Set to 0 to disable ordinary-attachment stage/count diagnostics.
# EMAIL_ATTACHMENT_DIAGNOSTICS=0
# Set to 0 to disable privacy-safe Outlook send stage diagnostics in the server CLI.
# SEND_EVENT_DIAGNOSTICS=0
